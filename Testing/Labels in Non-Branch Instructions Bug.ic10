define ticksPerDay 2400
define lightPerDay 1900
define mainBatteryHigh 0.5
define mainBatteryLow 0.2
define craftOPC 5
define clearOPC 4
define ejectOPC 3
define autolatheCode 5
define elecPrinterCode 4
define pipeBenderCode 3
define toolFactoryCode 2
define coolingStartTemp 300.15
define coolingLowTemp 295.15
define ph2oShutoff 1.4

alias habGrowlight d0
alias solidGen d1
alias mainBattery d2
alias coolingAnalyzer d3
alias habSensor d4
alias coolingVent d5

alias clock r15
alias prevDS r14
alias dayClock r13
alias coolingState r12

move clock 0
lbn prevDS HASH("StructureDaylightSensor") HASH("surface_sensor") Activate Sum
move dayClock -1
put db autolatheCode 4700
put db elecPrinterCode 4701
put db pipeBenderCode 4702
put db toolFactoryCode 11024
move coolingState waitForHot

tickStart:
yield

# clock
lbn r1 HASH("StructureDaylightSensor") HASH("surface_sensor") Activate Sum
seq r0 prevDS r1
move prevDS r1
mul clock clock r0
select r0 r1 1 -1
add clock clock r0
s db Setting clock

# grow light
add dayClock dayClock 1
slt r0 dayClock ticksPerDay
mul dayClock dayClock r0
slt r0 dayClock lightPerDay
s habGrowlight On r0

# solar
lbn r0 HASH("StructureDaylightSensor") HASH("surface_sensor") Horizontal Sum
sub r0 r0 90
sb HASH("StructureSolarPanelDual") Horizontal r0
lbn r0 HASH("StructureDaylightSensor") HASH("surface_sensor") Vertical Sum
sub r0 90 r0
sb HASH("StructureSolarPanelDual") Vertical r0

# solid fuel
l r0 mainBattery Ratio
brgt r0 mainBatteryLow 2
s solidGen On 1
brlt r0 mainBatteryHigh 2
s solidGen On 0

# shower purifier
lbn r0 HASH("StructureLiquidPipeAnalyzer") HASH("purifier_analyzer") VolumeOfLiquid Sum
sgt r0 r0 ph2oShutoff
sbn HASH("StructureTurboVolumePump") HASH("purifier_tvp") On r0
sbn HASH("StructurePressurantValve") HASH("purifier_press") On r0

# crafters
lbn r2 HASH("StructureLogicMemory") HASH("crafter_control") Setting Sum
sbn HASH("StructureLogicMemory") HASH("crafter_control") Setting 0
beqz r2 coolingState
mod r0 r2 10
sub r0 r0 5
abs r0 r0

div r2 r2 10
trunc r2 r2
mod r1 r2 10
sub r1 r1 5
abs r1 r1
get r1 db r1

div r2 r2 10
trunc r2 r2

beq r0 craftOPC craft
beq r0 clearOPC clear
beq r0 ejectOPC eject
j coolingState

craft:
l r0 r1 RecipeHash
sll r0 r0 8
or r0 r0 r2
sll r0 r0 8
or r0 r0 2
put r1 0 r0
j coolingState

clear:
clrd r1
j coolingState

eject:
sll r0 r2 8
or r0 r0 7
put r1 0 r0
j coolingState

# cooling
waitForHot:
l r0 habSensor Temperature
blt r0 coolingStartTemp tickStart
s coolingVent Mode 1
s coolingVent On 1
move coolingState waitForPressure
j tickStart

waitForPressure:
move coolingState pressureDone
j tickStart

pressureDone:
s coolingVent On 0
move coolingState waitForCold
j tickStart

waitForCold:
l r0 coolingAnalyzer Temperature
l r1 habSensor Temperature
l r2 habSensor Pressure
mul r0 10 r0
mul r1 r2 r1
add r0 r0 r1
add r1 10 r2
div r0 r0 r1
blt r0 coolingLowTemp releaseCold
j tickStart

releaseCold:
s coolingVent Mode 0
s coolingVent On 1
move coolingState waitForVacuum
j tickStart

waitForVacuum:
move coolingState vacuumDone
j tickStart

vacuumDone:
s coolingVent On 0
move coolingState waitForHot
j tickStart